{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@galinum/core": ["../core/src/index.ts"],
      "@galinum/core/contract": ["../core/src/management-contract.ts"],
      "@galinum/dashboard/mount": ["../dashboard/src/mount.tsx"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.mts", "src/**/*.tsx"]
}
